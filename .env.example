# HAMI Widget — Railway Backend URL
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your Railway backend URL.
# In Vercel, add VITE_HAMI_API_URL as a project environment variable.
#
# Example:
#   VITE_HAMI_API_URL=https://your-app.railway.app
#
# The HAMI backend runs on Railway and is NOT part of this project.
# Do not commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

VITE_HAMI_API_URL=https://your-app.railway.app
